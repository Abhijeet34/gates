#!/bin/sh
# Prepend Homebrew prefix so this hook works when git is invoked from processes
# that run with a stripped PATH (e.g. Homebrew internal auto-update). Only when
# missing: git-lfs resolves the credential helper's bare `gh` on this PATH, and
# a reorder hands it the real gh in place of an agent's wrapper.
for d in /usr/local/bin /opt/homebrew/bin; do
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
export PATH
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-commit' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-commit "$@"
